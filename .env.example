PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/invitation

# Frontend origins (comma-separated). Production must not be localhost-only.
CLIENT_ORIGIN=http://localhost:3000
CLIENT_ORIGINS=http://localhost:3000

# Trust the first proxy hop (nginx / load balancer) so req.ip is correct for rate limits.
# Set to 0 to disable. Use 1 behind a single reverse proxy.
TRUST_PROXY=1

# Auth secrets — use long random strings (32+ chars) in production
JWT_ACCESS_SECRET=replace-with-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-long-random-refresh-secret

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google Sign-In (optional locally; required if you enable Google login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SMTP (Gmail App Password or other provider)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Save the Kath <noreply@example.com>
SUPPORT_EMAIL=support@example.com

# Razorpay — real keys required when NODE_ENV=production
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=replace-me
RAZORPAY_WEBHOOK_SECRET=replace-me

# Optional
CURRENCY=INR
