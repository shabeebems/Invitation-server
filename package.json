{
  "name": "invitation-server",
  "version": "1.0.0",
  "description": "Invitation API server",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon",
    "build": "tsc",
    "test": "tsx --test src/services/auth/refresh-decision.test.ts",
    "start": "node dist/server.js",
    "seed:assets": "tsx src/scripts/upload-site-assets.ts",
    "seed:templates": "tsx src/scripts/import-royal-reception.ts && tsx src/scripts/import-parambil-house.ts",
    "seed:enabled-sections": "tsx src/scripts/seed-enabled-sections.ts",
    "seed:house-layouts": "tsx src/scripts/seed-house-layouts.ts",
    "cleanup:templates": "tsx src/scripts/cleanup-removed-templates.ts",
    "cleanup:royal-themes": "tsx src/scripts/cleanup-royal-themes.ts",
    "cleanup:royal-content": "tsx src/scripts/cleanup-royal-content.ts",
    "cleanup:royal": "tsx src/scripts/cleanup-royal-themes.ts && tsx src/scripts/cleanup-royal-content.ts",
    "cleanup:maps-legacy": "tsx src/scripts/cleanup-maps-legacy.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "google-auth-library": "^11.1.0",
    "helmet": "^8.3.0",
    "inversify": "^6.2.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.9.5",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.10",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^8.0.2",
    "nodemon": "^3.1.14",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
